{
  "name": "mcp-onedrive-sharepoint",
  "version": "1.0.0",
  "description": "MCP server and CLI for OneDrive and SharePoint via Microsoft Graph",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "build/**",
    "!build/tests/**",
    "!build/.tsbuildinfo",
    "!build/**/*.map",
    "!build/utils/test-enhancements.*",
    "scripts/ods.sh",
    "scripts/onepassword-graph-env.sh",
    "scripts/run-stdio.sh",
    "scripts/spcall.sh",
    "scripts/with-onepassword-graph-env.sh",
    "config/sites.example.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc --pretty false",
    "dev": "./scripts/with-onepassword-graph-env.sh npx tsx src/index.ts",
    "cli": "./scripts/ods.sh",
    "start": "./scripts/run-stdio.sh",
    "stdio": "./scripts/run-stdio.sh",
    "spcall": "./scripts/spcall.sh",
    "setup-auth": "./scripts/with-onepassword-graph-env.sh npx tsx src/auth/setup-auth.ts",
    "test": "npm run build && MCP_LOCAL_FILE_ROOT=/ node --test build/tests/*.test.js",
    "lint": "eslint . --ext .ts --max-warnings 393",
    "ci": "npm run build && npm run lint && npm test",
    "format": "prettier --write \"src/**/*.ts\" README.md SECURITY.md scripts/*.mjs"
  },
  "keywords": [
    "mcp",
    "onedrive",
    "sharepoint",
    "microsoft-graph",
    "llm-tools",
    "cli"
  ],
  "author": "Fernando Taricano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftaricano/mcp-onedrive-sharepoint.git"
  },
  "bugs": {
    "url": "https://github.com/ftaricano/mcp-onedrive-sharepoint/issues"
  },
  "homepage": "https://github.com/ftaricano/mcp-onedrive-sharepoint#readme",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^2.6.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.7",
    "form-data": "^4.0.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "bin": {
    "mcp-onedrive-sharepoint": "./scripts/run-stdio.sh",
    "ods": "./scripts/ods.sh",
    "sharepoint-mcp-stdio": "./scripts/run-stdio.sh",
    "spcall": "./scripts/spcall.sh"
  }
}
