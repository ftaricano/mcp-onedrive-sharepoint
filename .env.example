# Required at runtime, from the process environment (use your secret manager):
#   MICROSOFT_GRAPH_TENANT_ID, MICROSOFT_GRAPH_CLIENT_ID, MICROSOFT_GRAPH_CLIENT_SECRET
# Do not put the client ID, secret or tenant ID in this file; .env files are never loaded.
MICROSOFT_GRAPH_SCOPES=Files.ReadWrite.All,Sites.ReadWrite.All,Directory.Read.All,User.Read,offline_access
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_TIMEOUT=30000
MICROSOFT_GRAPH_MAX_RETRIES=3
MICROSOFT_GRAPH_CACHE_ENABLED=true
MICROSOFT_GRAPH_CACHE_TTL=3600

# Tool surface
# core = safe default tool set; full = advanced/destructive tools too
MCP_TOOL_PROFILE=core

# Optional comma-separated denylist, e.g. "delete_item,manage_permissions"
MCP_DISABLED_TOOLS=

# Raw Microsoft Graph batch calls are experimental/admin-only and disabled by default.
MCP_ENABLE_EXPERIMENTAL_GRAPH_BATCH=false
